# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" (já está no .gitignore).

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-django-utils
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Chave dedicada para criptografar campos sensiveis em repouso (ex.: segredo TOTP).
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a SECRET_KEY nao invalida isto (e vice-versa) — sao independentes de proposito.
FIELD_ENCRYPTION_KEY=

# --- Banco de dados (SQLite por padrao, sem necessidade de servidor externo) ---
# Em desenvolvimento local NAO definir esta variavel (config/settings/dev.py ja usa um
# caminho fixo dentro de src/). Em producao/Docker, DEVE ser um caminho absoluto dentro do
# volume montado em docker/docker-compose.yml (senao o dado e perdido a cada deploy/rebuild
# do container, ja que o volume so persiste o que estiver dentro de /app/db).
DATABASE_PATH=/app/db/db.sqlite3

# --- Cloudflare Turnstile ---
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E-mail (conta Gmail dedicada para notificacoes) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Central de Chamados <no-reply@example.com>

# --- 2FA ---
OTP_ISSUER_NAME=LSERP Sistemas - Central de Chamados

# --- Backup (Cloudflare R2) ---
# Opcional: sem essas 5 variaveis, o backup fica desabilitado (settings.BACKUP_ENABLED=False)
# sem quebrar o resto da aplicacao — ver docs/security/backup-recovery.md.
# Token de API do R2: dash.cloudflare.com > R2 > "Manage API tokens" > criar um token com
# permissao "Object Read & Write", escopo restrito so ao bucket usado aqui.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BACKUP_PREFIX=bkp_uncisal
# Chave Fernet DEDICADA (nunca reaproveitar FIELD_ENCRYPTION_KEY, usada so pro TOTP).
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_COUNT=7
